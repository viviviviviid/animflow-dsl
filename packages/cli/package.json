{
  "name": "@animflow-dsl/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "bin": {
    "animflow": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && vitest run"
  },
  "dependencies": {
    "@animflow-dsl/compiler": "workspace:*",
    "@animflow-dsl/language": "workspace:*",
    "@animflow-dsl/migrate": "workspace:*",
    "@animflow-dsl/model": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
