{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animflow.dev/schemas/cli-report-v1.json",
  "title": "AnimFlow CLI report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "ok", "data", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "command": { "type": "string" },
    "ok": { "type": "boolean" },
    "data": { "type": ["object", "null"] },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "ok": { "const": false } }, "required": ["ok"] },
      "then": {
        "properties": {
          "data": { "type": "null" },
          "diagnostics": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] },
      "then": { "properties": { "data": { "type": "object" } } }
    }
  ],
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "line", "character"],
      "properties": {
        "offset": { "type": "integer", "minimum": 0 },
        "line": { "type": "integer", "minimum": 0 },
        "character": { "type": "integer", "minimum": 0 }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/position" },
        "end": { "$ref": "#/$defs/position" }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "message", "range"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["error", "warning"] },
        "message": { "type": "string", "minLength": 1 },
        "range": { "$ref": "#/$defs/range" },
        "related": { "type": "array" },
        "fixes": { "type": "array" }
      }
    }
  }
}
